/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "dma.h"
#include "spi.h"
#include "usart.h"
#include "gpio.h"
#include <stdio.h>

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);

/* USER CODE BEGIN 4 */
// 串口重定向，让 printf 能直接打印
int fputc(int ch, FILE *f)
{
    HAL_UART_Transmit(&huart1, (uint8_t *)&ch, 1, 0xFFFF);
    return ch;
}
/* USER CODE END 4 */

int main(void)
{
  /* USER CODE BEGIN 1 */
  // 【极其重要】重定向中断向量表
  SCB->VTOR = 0x08005000; 
  
  // 2. 【极其重要】清除从 Bootloader 带过来的挂起中断
  NVIC_ClearPendingIRQ(USART1_IRQn);
  NVIC_ClearPendingIRQ(USART3_IRQn);
  
  // 3. 打开全局中断

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  MX_USART3_UART_Init();
    __enable_irq();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Infinite loop */
    // 在 main 最开始加上这一句，开启 GPIO 时钟

  
    RCC->APB2ENR |= RCC_APB2ENR_IOPAEN;

  while (1)
  {
      // 直接把 PA1 拉低（假设你的灯是低电平点亮）
      GPIOA->BRR = GPIO_PIN_1; 
      
      // 纯软件延时（哪怕时钟配错了，这个也能跑）
      for (volatile int i = 0; i < 500000; i++);

      // 直接把 PA1 拉高
      GPIOA->BSRR = GPIO_PIN_1; 
      
      for (volatile int i = 0; i < 500000; i++);
  }
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
